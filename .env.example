# SISO Client Environment Configuration
# Android Emulator: http://10.0.2.2:3000 | iOS Simulator/Web: http://localhost:3000 | Device thật: http://<LAN_IP>:3000
API_BASE_URL=http://localhost:3000
SOCKET_URL=http://localhost:3000/turf-ws

# Spatial & Battlefield Config
H3_RESOLUTION=10
CAMPUS_BOUNDARY=BINH_THANH

# Thông báo đẩy (FCM). Để trống thì app dùng android/app/google-services.json và ios/Runner/GoogleService-Info.plist;
# không có cả hai thì app vẫn chạy, chỉ không nhận thông báo.
# Lấy trong android/app/google-services.json và ios/Runner/GoogleService-Info.plist:
#   FIREBASE_PROJECT_ID          = project_info.project_id            | PROJECT_ID
#   FIREBASE_MESSAGING_SENDER_ID = project_info.project_number        | GCM_SENDER_ID
#   FIREBASE_ANDROID_APP_ID      = client[0].client_info.mobilesdk_app_id
#   FIREBASE_ANDROID_API_KEY     = client[0].api_key[0].current_key
#   FIREBASE_IOS_APP_ID          = GOOGLE_APP_ID
#   FIREBASE_IOS_API_KEY         = API_KEY

