{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(**/*.env)",
      "Read(**/local.properties)",
      "Read(**/key.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.mobileprovision)",
      "Read(**/service-account*.json)",
      "Read(**/supabase/.temp/**)",
      "Read(**/secrets/**)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  }
}
