# =============================================================================
# SISO BACKEND (NESTJS) ENVIRONMENT CONFIGURATION
# =============================================================================
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION: SUPABASE CLOUD POSTGRESQL (Hoặc Local Postgres)
# Lấy từ Supabase Dashboard: Project Settings -> Database -> Connection Info
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres
# Bật DB_SSL=true khi kết nối tới Supabase Cloud, tắt false khi chạy Postgres Local
DB_SSL=true

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Cache & PubSub cho WebSocket)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# SECURITY & JWT CONFIGURATION
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_256_bit_jwt_secret
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# SPATIAL CONFIGURATION (UBER H3 RESOLUTION)
# -----------------------------------------------------------------------------
H3_DEFAULT_RESOLUTION=10
