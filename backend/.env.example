# =============================================================================
# SISO BACKEND (NESTJS) ENVIRONMENT CONFIGURATION
# =============================================================================
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION: SUPABASE CLOUD POSTGRESQL (Hoặc Local Postgres)
# Lấy từ Supabase Dashboard: Project Settings -> Database -> Connection Info
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres
# Bật DB_SSL=true khi kết nối tới Supabase Cloud, tắt false khi chạy Postgres Local
DB_SSL=true

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Cache & PubSub cho WebSocket)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# SECURITY & JWT CONFIGURATION
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_256_bit_jwt_secret
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# OTP EMAIL (MODULE 1 - AUTH)
# OTP_DEV_MODE=true: không gửi email, OTP cố định 123456 (dev/demo).
# OTP_DEV_MODE=false: sinh OTP ngẫu nhiên và gửi qua SMTP, bắt buộc điền SMTP_*.
# Gmail: bật xác minh 2 bước -> tạo App Password tại https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
OTP_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="SISO <your_gmail@gmail.com>"

# -----------------------------------------------------------------------------
# SPATIAL CONFIGURATION (UBER H3 RESOLUTION)
# -----------------------------------------------------------------------------
H3_DEFAULT_RESOLUTION=10
